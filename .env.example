# Copy to `.env` in the project root. ADK loads it automatically.

# --- Model access ----------------------------------------------------------
# Option A: Google AI Studio key (simplest) — https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-key-here

# Option B: Vertex AI (uncomment and comment out Option A)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Copilot configuration -------------------------------------------------
# gemini-2.5-flash is capped at 20 requests/day on the free tier.
GCLP_MODEL=gemini-flash-latest
GCLP_TRACK=Cloud Cybersecurity
GCLP_PROGRAM_WEEKS=12
# GCLP_DATA_DIR=/path/to/data
# GCLP_TEMPLATES_PATH=/path/to/templates.yaml
